{
  "version": 1,
  "author": "Pele Academia - Monitor Ambiental",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -60,
      "left": 190,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 70,
      "left": 230,
      "attrs": { "temperature": "26.5", "humidity": "55" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 220,
      "left": 170,
      "attrs": { "color": "blue", "label": "Silenciar" }
    },
    {
      "type": "wokwi-led",
      "id": "led_vermelho",
      "top": -20,
      "left": -110,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-led",
      "id": "led_verde",
      "top": -20,
      "left": -170,
      "attrs": { "color": "limegreen" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 100,
      "left": -90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 130,
      "left": -150,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": -40,
      "left": -270,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_nuvem",
      "top": 200,
      "left": -110,
      "attrs": {}
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.2", "black", [] ],
    [ "oled1:SDA", "esp:21", "blue", [] ],
    [ "oled1:SCL", "esp:22", "purple", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.2", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],

    [ "btn1:1.l", "esp:4", "cyan", [] ],
    [ "btn1:2.l", "esp:GND.2", "black", [] ],

    [ "esp:26", "r1:2", "orange", [] ],
    [ "r1:1", "led_vermelho:A", "orange", [] ],
    [ "led_vermelho:C", "esp:GND.1", "black", [] ],

    [ "esp:27", "r2:2", "green", [] ],
    [ "r2:1", "led_verde:A", "green", [] ],
    [ "led_verde:C", "esp:GND.1", "black", [] ],

    [ "esp:25", "bz1:2", "gold", [] ],
    [ "bz1:1", "esp:GND.1", "black", [] ],

    [ "esp:13", "sw_nuvem:2", "magenta", [] ],
    [ "sw_nuvem:1", "esp:GND.1", "black", [] ],
    [ "sw_nuvem:3", "esp:3V3", "red", [] ]
  ],
  "dependencies": {}
}
